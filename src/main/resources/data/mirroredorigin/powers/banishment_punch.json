{
  "type": "origins:multiple",
  "cooldown_timer": {
    "type": "origins:resource",
    "min": 0,
    "max": 12000,
    "survives_death": true,
    "hud_render": {
      "should_render": true,
      "bar_index": 12,
      "sprite_location": "mirroredorigin:textures/gui/banishment_punch_inact.png",
      "inverted": true,
      "condition": {
        "type": "origins:resource",
        "resource": "mirroredorigin:banishment_punch_charge_timer",
        "comparison": "==",
        "compare_to": 0
      }
    }
  },
  "charge_timer": {
    "type": "origins:resource",
    "min": 0,
    "max": 60,
    "hud_render": {
      "should_render": true,
      "bar_index": 12,
      "sprite_location": "mirroredorigin:textures/gui/banishment_punch.png",
      "condition": {
        "type": "origins:resource",
        "resource": "mirroredorigin:banishment_punch_charge_timer",
        "comparison": ">",
        "compare_to": 0
      }
    }
  },
  "tick_timers": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else",
          "condition": {
            "type": "origins:resource",
            "resource": "mirroredorigin:banishment_punch_cooldown_timer",
            "comparison": ">",
            "compare_to": 0
          },
          "if_action": {
            "type": "origins:change_resource",
            "resource": "mirroredorigin:banishment_punch_cooldown_timer",
            "change": -1
          }
        },
        {
          "type": "origins:if_else",
          "condition": {
            "type": "origins:resource",
            "resource": "mirroredorigin:banishment_punch_charge_timer",
            "comparison": ">",
            "compare_to": 0
          },
          "if_action": {
            "type": "origins:change_resource",
            "resource": "mirroredorigin:banishment_punch_charge_timer",
            "change": -1
          }
        }
      ]
    }
  },
  "activate_charge": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "mirroredorigin:banishment_punch_cooldown_timer",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": "==",
          "compare_to": 0.0
        }
      ]
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "mirroredorigin:banishment_punch_charge_timer",
          "change": 60,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "mirroredorigin:banishment_punch_cooldown_timer",
          "change": 6000,
          "operation": "set"
        },
        {
          "type": "origins:execute_command",
          "command": "particle minecraft:enchant ~ ~1 ~ 0.5 0.5 0.5 0.1 20"
        },
        {
          "type": "origins:play_sound",
          "sound": "minecraft:block.beacon.activate",
          "volume": 1.0,
          "pitch": 1.5
        }
      ]
    },
    "key": {
      "key": "key.origins.secondary_active"
    }
  },
  "on_punch_success": {
    "type": "origins:action_on_hit",
    "bypasses_cooldown": true,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "mirroredorigin:banishment_punch_charge_timer",
          "comparison": ">",
          "compare_to": 0
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "mainhand",
          "item_condition": {
            "type": "origins:empty"
          }
        }
      ]
    },
    "bientity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:target_action",
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:if_else",
                "condition": {
                  "type": "origins:entity_type",
                  "entity_type": "minecraft:player"
                },
                "if_action": {
                  "type": "origins:if_else",
                  "condition": {
                    "type": "origins:power",
                    "power": "mirroredorigin:in_mirror_world"
                  },
                  "if_action": {
                    "type": "origins:revoke_power",
                    "power": "mirroredorigin:in_mirror_world",
                    "source": "mirroredorigin:banishment_punch"
                  },
                  "else_action": {
                    "type": "origins:grant_power",
                    "power": "mirroredorigin:in_mirror_world",
                    "source": "mirroredorigin:banishment_punch"
                  }
                },
                "else_action": {
                  "type": "origins:if_else",
                  "condition": {
                    "type": "mirroredorigin:in_mirror_world"
                  },
                  "if_action": {
                    "type": "mirroredorigin:set_phase",
                    "in_mirror": false
                  },
                  "else_action": {
                    "type": "mirroredorigin:set_phase",
                    "in_mirror": true
                  }
                }
              },
              {
                "type": "mirroredorigin:cross_phase_effect",
                "sound": "minecraft:entity.enderman.teleport",
                "volume": 1.0,
                "pitch": 0.7,
                "particle": "minecraft:reverse_portal",
                "count": 60,
                "spread": 0.6,
                "speed": 0.1
              }
            ]
          }
        },
        {
          "type": "origins:actor_action",
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:change_resource",
                "resource": "mirroredorigin:banishment_punch_charge_timer",
                "change": 0,
                "operation": "set"
              },
              {
                "type": "origins:change_resource",
                "resource": "mirroredorigin:banishment_punch_cooldown_timer",
                "change": 12000,
                "operation": "set"
              },
              {
                "type": "mirroredorigin:cross_phase_effect",
                "sound": "minecraft:item.totem.use",
                "volume": 0.8,
                "pitch": 0.5
              },
              {
                "type": "mirroredorigin:cross_phase_effect",
                "sound": "minecraft:block.glass.break",
                "volume": 1.0,
                "pitch": 0.8
              }
            ]
          }
        }
      ]
    }
  },
  "on_charge_expire": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:resource",
      "resource": "mirroredorigin:banishment_punch_charge_timer",
      "comparison": "==",
      "compare_to": 1
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:block.fire.extinguish",
          "volume": 0.5,
          "pitch": 1.0
        },
        {
          "type": "origins:play_sound",
          "sound": "minecraft:block.glass.step",
          "volume": 1.0,
          "pitch": 0.5
        }
      ]
    }
  }
}