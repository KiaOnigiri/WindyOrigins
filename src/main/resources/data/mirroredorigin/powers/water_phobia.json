{
  "type": "origins:action_over_time",
  "interval": 5,
  "condition": {
    "type": "origins:and",
    "conditions": [
      {
        "type": "origins:fluid_height",
        "fluid": "minecraft:water",
        "comparison": ">",
        "compare_to": 0.0
      },
      {
        "type": "origins:power_active",
        "power": "mirroredorigin:in_mirror_world",
        "inverted": true
      }
    ]
  },
  "entity_action": {
    "type": "origins:execute_command",
    "command": "power grant @s mirroredorigin:in_mirror_world"
  }
}
